.DS_Store
.vercel
node_modules/
.env*

# vision pseudotime pilot — large pixels / derived artifacts NEVER enter git.
# Ignore the CONTENTS (not the dir) so the README marker stays tracked; git will
# not descend into a fully-ignored directory, which would drop the negation.
calibration_data/vision_pseudotime/derived/*
!calibration_data/vision_pseudotime/derived/README.txt
vision_local.json
*.tif
*.tiff
*.avi
*.mov
*.mp4
__pycache__/
*.pyc

# 3D pronuclear pseudotime — large/derived artifacts and resolved-path files out of git
calibration_data/pn3d/derived/*
!calibration_data/pn3d/derived/README.txt
# per-embryo orthogonal previews ARE published: they are the model's visible input,
# and the site shows them for every embryo (small downsampled PNGs, ~15 MB total)
!calibration_data/pn3d/derived/previews/
pn3d_local.json
